# Claude (console.anthropic.com > API keys)
ANTHROPIC_API_KEY=
# Optional: which Claude model writes the texts
DOG_MODEL=claude-haiku-5-5

# Twilio (console.twilio.com > Account info)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
# The dog line, in +1XXXXXXXXXX format
TWILIO_PHONE_NUMBER=

# Upstash Redis (added automatically when you connect Upstash from Vercel's Storage tab)
KV_REST_API_URL=
KV_REST_API_TOKEN=

# Any long random string. The scheduler sends it so strangers can't trigger texts.
CRON_SECRET=

# Your live site address, no trailing slash, e.g. https://dog-texts.vercel.app
PUBLIC_BASE_URL=
